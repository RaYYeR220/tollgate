# Tollgate contracts — deploy environment. Copy to .env and fill in.

# Burner deployer key, funded with a little Arbitrum ETH for gas only.
PRIVATE_KEY=

# Etherscan v2 multichain API key (etherscan.io/myapikey) — verifies on Arbiscan.
ETHERSCAN_API_KEY=

# RPCs
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Constructor args
PAYMENT_TOKEN=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
FEE_RECIPIENT=
FEE_BPS=250
