# Tollgate — frontend environment. Copy to .env.local and fill in.

# ── Particle Network · dashboard.particle.network ───────────────────────────
# New Project → add a Web app → copy these three from the app's settings.
NEXT_PUBLIC_PARTICLE_PROJECT_ID=
NEXT_PUBLIC_PARTICLE_CLIENT_KEY=
NEXT_PUBLIC_PARTICLE_APP_ID=

# ── Privy · dashboard.privy.io ──────────────────────────────────────────────
# New App → enable Email + Google login and embedded wallets → copy App ID +
# Client ID. Add http://localhost:3000 to the app's allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ── Settlement ──────────────────────────────────────────────────────────────
# TollgateAccessRegistry address (filled after the mainnet deploy). When set, the
# gate trusts ONLY the on-chain hasAccess read — no client token can grant access.
NEXT_PUBLIC_REGISTRY_ADDRESS=
# RPC the server uses to verify entitlement on-chain.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Public sandbox: TOLLGATE_DEMO=1 opens the gate so anyone can try the flow without
# spending real USDC. Leave UNSET for a live, on-chain-only build.
TOLLGATE_DEMO=1

# Server-only Privy secret (NEVER prefix with NEXT_PUBLIC_). Used to verify the
# authenticated session server-side so the payer can't be spoofed.
PRIVY_APP_SECRET=
